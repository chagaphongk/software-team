{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${extensionPath}/hooks/guard_bash.py\""
          }
        ]
      },
      {
        "matcher": "read_file|replace|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${extensionPath}/hooks/guard_secrets.py\""
          }
        ]
      },
      {
        "matcher": "builder|tdd-builder|reviewer|security-reviewer|verifier|researcher|documenter|deployer|designer",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${extensionPath}/hooks/log_agent.py\""
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "builder|tdd-builder|reviewer|security-reviewer|verifier|researcher|documenter|deployer|designer",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${extensionPath}/hooks/log_agent.py\""
          }
        ]
      }
    ],
    "PreCompress": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${extensionPath}/hooks/pre_compact.py\""
          }
        ]
      }
    ]
  }
}
